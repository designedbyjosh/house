{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::house-static-sitebucket-5hyruwxai9bo",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "releases/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::house-static-sitebucket-5hyruwxai9bo/releases/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::347069581928:distribution/E34SQFRYPO72S6"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeEvents",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-2:347069581928:stack/house-static/*",
        "arn:aws:cloudformation:ap-southeast-2:347069581928:changeSet/house-*/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-2:347069581928:stack/house-static/*",
        "arn:aws:cloudformation:ap-southeast-2:347069581928:changeSet/house-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::347069581928:role/house-cloudformation-execution"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::347069581928:role/house-cloudformation-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::house-static-sitebucket-5hyruwxai9bo"
    }
  ]
}
