# Configure these in the Vercel house project, scoped to Production.
# UMAMI_API_KEY must be a server-only Secret, never a public/client variable.
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Optional separate Umami property for Preview/Development. Without it, no tracking.
# Never copy the production website ID or key into these variables.
UMAMI_PREVIEW_WEBSITE_ID=
UMAMI_PREVIEW_API_KEY=
